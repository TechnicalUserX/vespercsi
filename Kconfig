mainmenu "VesperCSI Configuration"

    menu "Compiler"

        menuconfig VESPERCSI_COMPILER_GLOBAL
            bool "Set Global settings"
            default n

            config VESPERCSI_COMPILER_GLOBAL_CC
                string "CC"
                default "gcc"
                depends on VESPERCSI_COMPILER_GLOBAL
        
            config VESPERCSI_COMPILER_GLOBAL_CFLAGS
                string "CFLAGS"
                default ""
                depends on VESPERCSI_COMPILER_GLOBAL

            config VESPERCSI_COMPILER_GLOBAL_CPPFLAGS
                string "CPPFLAGS"
                default ""
                depends on VESPERCSI_COMPILER_GLOBAL

            config VESPERCSI_COMPILER_GLOBAL_CXX
                string "CXX"
                default "g++"
                depends on VESPERCSI_COMPILER_GLOBAL

            config VESPERCSI_COMPILER_GLOBAL_CXXFLAGS
                string "CXXFLAGS"
                default ""
                depends on VESPERCSI_COMPILER_GLOBAL

            config VESPERCSI_COMPILER_GLOBAL_LDFLAGS
                string "LDFLAGS"
                default ""
                depends on VESPERCSI_COMPILER_GLOBAL

    endmenu

    menu "Channel State Information"

        menuconfig VESPERCSI_CSI_LIMITS
            bool "Set Internal Limits"
            default n

            config VESPERCSI_CSI_SUPPORTED_TX_MAX
                int "Maximum Supported TX Count"
                default 1
                depends on VESPERCSI_CSI_LIMITS

            config VESPERCSI_CSI_SUPPORTED_RX_MAX
                int "Maximum Supported RX Count"
                default 1
                depends on VESPERCSI_CSI_LIMITS

            config VESPERCSI_CSI_SUPPORTED_SUBCARRIERS_MAX
                int "Maximum Supported Subcarriers"
                default 56
                depends on VESPERCSI_CSI_LIMITS

            config VESPERCSI_CSI_SUPPORTED_TIME_FRAME_MAX
                int "Maximum Supported CSI Capture Time Frame"
                default 3
                depends on VESPERCSI_CSI_LIMITS

            config VESPERCSI_CSI_SUPPORTED_RATE_MAX
                int "Maximum Supported CSI Capture Per Second"
                default 100
                depends on VESPERCSI_CSI_LIMITS

    endmenu

    menu "Wireless"

        menuconfig VESPERCSI_WIFI
            bool "Override Interface Defaults"
            default n

            config VESPERCSI_WIFI_INTERFACE
                string "Monitor Mode Interface Name"
                default "vespercsimon"
                depends on VESPERCSI_WIFI

            config VESPERCSI_WIFI_INTERFACE_MAX_SIZE
                int "Maximum number of interfaces enumerable"
                default 10
                depends on VESPERCSI_WIFI

            config VESPERCSI_WIFI_PHY_MAX_SIZE
                int "Maximum number of phys enumerable"
                default 10
                depends on VESPERCSI_WIFI

    endmenu

    menu "Plugin System"

        menuconfig VESPERCSI_PLUGINS
            bool "Override Plugin System Defaults"
            default n

        config VESPERCSI_PLUGIN_FOLDER
            string "Directory to search for plugins"
            default "/etc/vespercsi/plugins"
            depends on VESPERCSI_PLUGINS

        source "plugins/Kconfig"
    
    endmenu
